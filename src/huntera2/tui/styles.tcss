Screen { background: $background; color: $text; }

#banner {
    height: 3; padding: 0;
    background: $panel;
    border: heavy $primary;
    content-align: center middle;
    text-align: center;
}

#body { height: 1fr; }

#sidebar {
    width: 30; background: $surface;
    border-right: heavy $primary;
    padding: 0 1;
}

#sidebar-title {
    padding: 0 1; color: $accent;
    text-style: bold; height: 1;
}

#category-bar {
    height: 1; color: $text-muted;
    padding: 0 1;
}

#plugin-list { background: transparent; height: 1fr; }

ListItem { background: transparent; padding: 0 1; }
ListView > ListItem > Label {
    background: transparent;
    width: 100%;
}

.category-header {
    color: $accent;
    text-style: bold;
    padding: 1 0 0 0;
    background: transparent;
}
.category-header.--highlight {
    background: transparent;
    color: $accent;
}

#main { padding: 0 1; background: $background; }

#plugin-title {
    text-style: bold; color: $accent;
    padding: 0 1 1 1;
    height: 2;
    border-bottom: solid $primary-darken-2;
}

#plugin-desc { color: $text-muted; padding: 0 1; height: 1; }
#hint { color: $text-disabled; padding: 0 1; height: 1; }

#args {
    background: $panel;
    border: heavy $primary-darken-1;
    color: $text;
}
#args:focus { border: heavy $accent; }

#run {
    margin: 1 0; background: $primary;
    color: $text;
    border: heavy $accent;
    width: 100%;
}
#run:hover { background: $accent; color: $background; }

#output {
    background: $surface;
    border: round $primary-darken-1;
    padding: 0 2;
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary;
    scrollbar-background: $panel;
}
#output:focus { border: round $accent; }

#chart {
    height: 18;
    background: $surface;
    border: round $primary-darken-1;
    padding: 0 1;
    margin-top: 1;
    display: none;
}

#status {
    height: 1; background: $surface;
    color: $text-muted; padding: 0 2;
    text-style: bold;
}

Footer { background: $panel; }

#progress {
    display: none;
    height: 1;
    margin: 1 0 0 0;
    color: $accent;
    background: $surface;
}
